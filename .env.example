# Dead Reckoning environment variables
#
# Copy this file to .env.local and fill in what you need:
#   cp .env.example .env.local
#
# Every variable here is OPTIONAL. With no .env.local at all, the app builds and
# runs fully offline against the bundled snapshots in src/data/snapshots/.

# ---------------------------------------------------------------------------
# Browser app (VITE_ prefix = inlined into the client bundle at build time)
# ---------------------------------------------------------------------------
# NASA API key used for the live DONKI space-weather request.
# Default when unset: DEMO_KEY.
#
# SECURITY: anything with the VITE_ prefix is PUBLIC. It is compiled into the
# JavaScript that every visitor downloads, so treat it as visible source code.
# DEMO_KEY is NASA's shared, rate-limited public key and is the correct choice
# for this demo. If you supply a personal key, assume it is public: use a key
# you can revoke, and never reuse a key that also grants paid quota elsewhere.
VITE_NASA_API_KEY=DEMO_KEY

# ---------------------------------------------------------------------------
# Node scripts (read from process.env, never bundled, never shipped)
# ---------------------------------------------------------------------------
# Key used by `node scripts/fetch-snapshots.mjs` to refresh the bundled
# offline snapshots. Unset = DEMO_KEY. The refresh script records the request
# URL in each snapshot with the key redacted, so a personal key is not written
# into the committed JSON.
NASA_API_KEY=
